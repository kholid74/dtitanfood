---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Favorites from "../components/Favorites.astro";
import Catering from "../components/Catering.astro";
import OurStory from "../components/OurStory.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Gallery from "../components/Gallery.astro";
import Ebook from "../components/Ebook.astro";
import HowToOrder from "../components/HowToOrder.astro";
import AvailableOn from "../components/AvailableOn.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

const title = "D'titans Food — Homemade Food & Catering";
const description = site.description;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="konten-utama">
    <Hero />
    <Favorites />
    <Catering />
    <OurStory />
    <WhyChooseUs />
    <Gallery />
    <Ebook />
    <HowToOrder />
    <AvailableOn />
  </main>
  <Footer />
</BaseLayout>
